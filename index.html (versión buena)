<!DOCTYPE html>

<html lang="es">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<title>Neuro Reactiva | Neurorrehabilitación a domicilio en Madrid</title>
<meta content="Neuro Reactiva ofrece neurorrehabilitación a domicilio en Madrid para personas con ictus, daño cerebral, Parkinson, lesión medular y otras enfermedades neurológicas." name="description"/>
<style>
    :root {
      --azul: #263847;
      --azul-2: #334A5F;
      --texto: #475A6C;
      --verde: #9BC8B8;
      --verde-2: #6FA48F;
      --coral: #D86F5C;
      --coral-2: #EF9A86;
      --fondo: #FFF6F2;
      --blanco: #FFFFFF;
      --linea: #EDDAD2;
      --sombra: 0 24px 60px rgba(38, 56, 71, .12);
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
      background: var(--fondo);
      color: var(--azul);
    }
    a { color: inherit; text-decoration: none; }
    .wrap { width: min(1160px, calc(100% - 40px)); margin: 0 auto; }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      padding: 15px 24px;
      font-weight: 850;
      border: 1px solid transparent;
      transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
      white-space: nowrap;
    }
    .btn:hover { transform: translateY(-2px); }
    .btn-primary { background: var(--coral); color: white; box-shadow: 0 18px 34px rgba(216,111,92,.24); }
    .btn-primary:hover { background: #c85f4d; }
    .btn-secondary { background: white; color: var(--azul); border-color: var(--verde); box-shadow: 0 10px 22px rgba(38,56,71,.06); }
    .btn-secondary:hover { background: #F8FFFC; }

    .floating {
      position: fixed;
      right: 22px;
      bottom: 22px;
      z-index: 50;
      background: var(--coral);
      color: white;
      border-radius: 999px;
      padding: 14px 20px;
      font-weight: 900;
      box-shadow: 0 18px 40px rgba(216,111,92,.28);
    }

    /* HEADER */
    .nav {
      position: sticky;
      top: 0;
      z-index: 40;
      backdrop-filter: blur(14px);
      background: rgba(255,253,252,.82);
      border-bottom: 1px solid rgba(237,218,210,.9);
    }
    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 76px;
      gap: 18px;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 13px;
    }
    .brand-logo {
      width: 56px;
      height: 56px;
      border-radius: 18px;
      background: white;
      border: 1px solid var(--linea);
      display: grid;
      place-items: center;
      font-weight: 1000;
      color: var(--azul-2);
      box-shadow: 0 10px 24px rgba(38,56,71,.08);
    }
    .brand-title {
      margin: 0;
      font-size: 21px;
      line-height: 1;
      font-weight: 1000;
      letter-spacing: -.035em;
      color: var(--azul);
    }
    .brand-sub {
      margin: 4px 0 0;
      color: var(--verde-2);
      font-size: 12px;
      font-weight: 780;
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 8px;
      border: 1px solid var(--linea);
      background: rgba(255,255,255,.78);
      border-radius: 999px;
      padding: 8px;
      box-shadow: 0 12px 26px rgba(38,56,71,.05);
    }
    .nav-links a {
      padding: 10px 14px;
      border-radius: 999px;
      font-size: 14px;
      font-weight: 800;
      color: var(--azul-2);
    }
    .nav-links a:hover { background: var(--fondo); color: var(--coral); }
    .nav-cta { background: var(--azul-2) !important; color: white !important; padding: 10px 18px !important; }

    /* HERO */
    .hero {
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(circle at 12% 18%, rgba(155,200,184,.30), transparent 28%),
        radial-gradient(circle at 86% 8%, rgba(239,154,134,.23), transparent 25%),
        linear-gradient(135deg, #FFFDFC 0%, #FFF6F2 100%);
      border-bottom: 1px solid var(--linea);
    }
    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(360px, .86fr);
      gap: 54px;
      align-items: center;
      padding: 78px 0 96px;
    }
    .pill {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      border-radius: 999px;
      border: 1px solid var(--linea);
      background: rgba(255,255,255,.78);
      padding: 10px 15px;
      color: var(--azul-2);
      font-size: 14px;
      font-weight: 850;
      box-shadow: 0 10px 24px rgba(38,56,71,.06);
    }
    .pill-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--coral-2); }
    h1 {
      margin: 26px 0 0;
      font-size: clamp(46px, 7vw, 82px);
      line-height: .94;
      letter-spacing: -.065em;
      color: var(--azul);
      font-weight: 1000;
      max-width: 760px;
    }
    .hero-lead {
      margin: 26px 0 0;
      max-width: 680px;
      color: var(--texto);
      font-size: 20px;
      line-height: 1.72;
      font-weight: 520;
    }
    .hero-actions {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      margin-top: 34px;
    }
    .mini-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      margin-top: 40px;
      max-width: 680px;
      overflow: hidden;
      background: rgba(255,255,255,.86);
      border: 1px solid var(--linea);
      border-radius: 28px;
      box-shadow: 0 14px 30px rgba(38,56,71,.06);
    }
    .mini-stat {
      padding: 22px;
      border-right: 1px solid var(--linea);
    }
    .mini-stat:last-child { border-right: 0; }
    .mini-stat strong {
      display: block;
      font-size: 27px;
      font-weight: 1000;
      color: var(--azul-2);
      letter-spacing: -.04em;
    }
    .mini-stat span {
      display: block;
      margin-top: 5px;
      font-size: 13px;
      line-height: 1.35;
      color: var(--texto);
      font-weight: 780;
    }

    /* PANEL DERECHO DEL HERO: sin solapamientos */
    .hero-panel {
      position: relative;
      background: white;
      border: 1px solid var(--linea);
      border-radius: 42px;
      padding: 22px;
      box-shadow: var(--sombra);
    }
    .hero-panel::before {
      content: "";
      position: absolute;
      left: -10px;
      top: 48px;
      width: 28px; /* antes era mucho más ancho */
      height: calc(100% - 96px);
      background: var(--verde);
      border-radius: 18px;
      z-index: 0;
    }
    .hero-panel-inner {
      position: relative;
      z-index: 1;
      background: #FFF2EE;
      border-radius: 32px;
      padding: 28px;
    }
    .panel-label {
      display: inline-flex;
      border-radius: 999px;
      background: white;
      padding: 9px 13px;
      color: var(--coral);
      font-size: 12px;
      font-weight: 1000;
      letter-spacing: .16em;
      text-transform: uppercase;
      box-shadow: 0 8px 18px rgba(38,56,71,.05);
    }
    .hero-panel h2 {
      margin: 26px 0 0;
      font-size: clamp(30px, 4vw, 42px);
      line-height: 1.05;
      letter-spacing: -.045em;
      color: var(--azul);
      font-weight: 1000;
    }
    .idea-card {
      margin-top: 24px;
      background: var(--coral);
      color: white;
      border-radius: 26px;
      padding: 24px;
      box-shadow: 0 18px 36px rgba(216,111,92,.22);
    }
    .idea-card small {
      display: block;
      margin-bottom: 10px;
      opacity: .8;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: .18em;
      font-weight: 1000;
    }
    .idea-card strong {
      display: block;
      font-size: clamp(24px, 3vw, 32px);
      line-height: 1.08;
      letter-spacing: -.03em;
    }
    .problem-list {
      display: grid;
      gap: 14px;
      margin-top: 20px;
    }
    .problem {
      display: grid;
      grid-template-columns: 42px 1fr;
      align-items: start;
      gap: 14px;
      background: white;
      border: 1px solid var(--linea);
      border-radius: 24px;
      padding: 16px;
      box-shadow: 0 10px 22px rgba(38,56,71,.04);
    }
    .problem-number {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 15px;
      background: var(--azul);
      color: white;
      font-weight: 1000;
      flex-shrink: 0;
    }
    .problem p {
      margin: 0;
      color: var(--texto);
      line-height: 1.48;
      font-size: 15px;
      font-weight: 780;
    }

    section { scroll-margin-top: 92px; }
    .section { padding: 92px 0; }
    .eyebrow {
      margin: 0 0 16px;
      color: var(--coral);
      text-transform: uppercase;
      letter-spacing: .20em;
      font-weight: 950;
      font-size: 12px;
    }
    .section-head {
      display: grid;
      grid-template-columns: .86fr 1.14fr;
      gap: 48px;
      align-items: end;
      margin-bottom: 46px;
    }
    .section-title {
      margin: 0;
      font-size: clamp(36px, 5vw, 60px);
      line-height: 1;
      letter-spacing: -.055em;
      font-weight: 1000;
      color: var(--azul);
    }
    .section-copy {
      margin: 0;
      color: var(--texto);
      font-size: 18px;
      line-height: 1.75;
      font-weight: 520;
    }
    .feature-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
    .feature {
      background: white;
      border: 1px solid var(--linea);
      border-radius: 32px;
      padding: 30px;
      box-shadow: 0 10px 24px rgba(38,56,71,.05);
    }
    .feature h3 {
      margin: 0;
      font-size: 30px;
      letter-spacing: -.04em;
      color: var(--azul-2);
    }
    .feature p {
      margin: 18px 0 0;
      color: var(--texto);
      font-size: 16px;
      line-height: 1.7;
      font-weight: 540;
    }

    .dark { background: var(--azul); color: white; }
    .dark .eyebrow { color: var(--verde); }
    .dark .section-title { color: white; }
    .service-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
      margin-top: 46px;
    }
    .service {
      border: 1px solid rgba(255,255,255,.12);
      background: rgba(255,255,255,.06);
      border-radius: 32px;
      padding: 28px;
    }
    .service small {
      color: var(--coral-2);
      text-transform: uppercase;
      letter-spacing: .16em;
      font-weight: 1000;
    }
    .service h3 {
      margin: 12px 0 0;
      font-size: 26px;
      letter-spacing: -.035em;
    }
    .service p {
      margin: 16px 0 0;
      color: rgba(255,255,255,.78);
      line-height: 1.72;
      font-weight: 500;
    }

    .method-grid {
      display: grid;
      grid-template-columns: .86fr 1.14fr;
      gap: 56px;
      align-items: start;
    }
    .timeline {
      display: grid;
      gap: 18px;
    }
    .step {
      display: grid;
      grid-template-columns: 56px 1fr;
      gap: 18px;
      background: white;
      border: 1px solid var(--linea);
      border-radius: 30px;
      padding: 24px;
      box-shadow: 0 10px 24px rgba(38,56,71,.05);
    }
    .step-num {
      width: 56px;
      height: 56px;
      display: grid;
      place-items: center;
      border-radius: 18px;
      background: var(--verde);
      color: var(--azul);
      font-weight: 1000;
    }
    .step h3 {
      margin: 3px 0 0;
      font-size: 21px;
      color: var(--azul);
    }
    .step p {
      margin: 8px 0 0;
      color: var(--texto);
      line-height: 1.62;
      font-weight: 500;
    }

    .about {
      background: #FFFDFC;
      border-top: 1px solid var(--linea);
      border-bottom: 1px solid var(--linea);
    }
    .about-grid {
      display: grid;
      grid-template-columns: .78fr 1.22fr;
      gap: 26px;
      align-items: stretch;
    }
    .about-card {
      border-radius: 34px;
      padding: 26px;
    }
    .about-left {
      background: var(--coral);
      color: white;
      box-shadow: 0 18px 40px rgba(216,111,92,.16);
      display: grid;
      grid-template-columns: 118px 1fr; /* más ajustado */
      gap: 20px;
      align-items: center;
      align-self: start; /* evita que el recuadro naranja se estire demasiado */
    }
    .portrait {
      width: 118px;
      height: 118px;
      border-radius: 26px;
      object-fit: cover;
      border: 3px solid rgba(255,255,255,.58);
      box-shadow: 0 14px 28px rgba(38,56,71,.18);
      background: rgba(255,255,255,.18);
    }
    .about-left .eyebrow {
      color: rgba(255,255,255,.78);
      margin-bottom: 10px;
    }
    .about-left h2 {
      margin: 0;
      color: white;
      font-size: 34px; /* menos grande */
      line-height: 1;
      letter-spacing: -.045em;
    }
    .about-left p {
      margin: 12px 0 0;
      color: rgba(255,255,255,.92);
      font-size: 15px;
      line-height: 1.45;
      font-weight: 720;
    }
    .about-right {
      background: var(--fondo);
      border: 1px solid var(--linea);
    }
    .about-right p {
      margin: 0;
      color: var(--texto);
      font-size: 18px;
      line-height: 1.82;
      font-weight: 500;
    }
    .about-right p + p { margin-top: 20px; }

    .contact {
      text-align: center;
      padding: 96px 0;
    }
    .contact h2 {
      margin: 0 auto;
      max-width: 900px;
      color: var(--azul);
      font-size: clamp(38px, 5.5vw, 68px);
      line-height: .98;
      letter-spacing: -.055em;
      font-weight: 1000;
    }
    .contact p {
      margin: 24px auto 0;
      max-width: 700px;
      color: var(--texto);
      font-size: 18px;
      line-height: 1.75;
    }
    .contact-actions {
      display: flex;
      gap: 14px;
      justify-content: center;
      flex-wrap: wrap;
      margin-top: 34px;
    }
    footer {
      background: #FFFDFC;
      border-top: 1px solid var(--linea);
      padding: 30px 0;
      text-align: center;
      color: var(--texto);
      font-weight: 720;
      font-size: 14px;
    }

    @media (max-width: 980px) {
      .nav-links { display: none; }
      .hero-grid,
      .section-head,
      .method-grid,
      .about-grid {
        grid-template-columns: 1fr;
      }
      .feature-grid,
      .service-grid {
        grid-template-columns: 1fr;
      }
      .mini-stats {
        grid-template-columns: 1fr;
      }
      .mini-stat {
        border-right: 0;
        border-bottom: 1px solid var(--linea);
      }
      .mini-stat:last-child { border-bottom: 0; }
      .hero-panel::before {
        left: -7px;
        width: 18px;
      }
    }

    @media (max-width: 620px) {
      .wrap { width: min(100% - 28px, 1160px); }
      .hero-grid { padding: 48px 0 74px; gap: 34px; }
      h1 { font-size: 48px; }
      .hero-lead { font-size: 18px; }
      .btn { width: 100%; }
      .hero-panel { border-radius: 30px; padding: 14px; }
      .hero-panel-inner { border-radius: 24px; padding: 22px; }
      .idea-card { border-radius: 22px; }
      .problem { grid-template-columns: 38px 1fr; border-radius: 20px; }
      .problem-number { width: 38px; height: 38px; }
      .section { padding: 70px 0; }
      .about-left {
        grid-template-columns: 1fr;
        text-align: center;
        padding: 24px;
      }
      .portrait {
        width: 128px;
        height: 128px;
        margin: 0 auto;
      }
      .floating { display: none; }
    }
  

    /* AJUSTES NEURO REACTIVA - versión corregida */
