<script>
  (function () {
    const nav = document.querySelector('.nav');
    const links = document.querySelectorAll('a[href^="#"]');

    function navHeight() {
      return nav ? Math.ceil(nav.getBoundingClientRect().height) : 0;
    }

    function setScrollOffset() {
      document.documentElement.style.setProperty('--scroll-offset', navHeight() + 'px');
    }

    function scrollToHash(hash, updateUrl) {
      if (!hash || hash === '#') return;
      const target = document.querySelector(hash);
      if (!target) return;
      setScrollOffset();
      const top = target.getBoundingClientRect().top + window.pageYOffset - navHeight();
      window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
      if (updateUrl) history.pushState(null, '', hash);
    }

    links.forEach(function (link) {
      link.addEventListener('click', function (event) {
        const hash = this.getAttribute('href');
        if (!hash || hash.charAt(0) !== '#' || !document.querySelector(hash)) return;
        event.preventDefault();
        scrollToHash(hash, true);
      });
    });

    setScrollOffset();
    window.addEventListener('resize', setScrollOffset);
    window.addEventListener('load', function () {
      setScrollOffset();
      if (window.location.hash) {
        setTimeout(function () { scrollToHash(window.location.hash, false); }, 30);
      }
    });
  })();
</script></body>
